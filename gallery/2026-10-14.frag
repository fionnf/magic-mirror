// Jade Lantern, Eclipsed - art of the day 2026-10-14
// A single emerald glass orb hangs in deep green dark: at morning it is lit from the front like a lantern, and through the afternoon its light slips behind it, until late at night only a pale mint rim and a wide breath of halo remain around a dark jade disc.
float dayEnergy(){ float s=0.0; float n=0.0; for(int i=0;i<24;i++){ float w=step(float(i)+0.5,iClock); s+=iDay[i]*w; n+=w; } return s/max(n,1.0); }
void mainImage(out vec4 fragColor, in vec2 fragCoord){ vec2 res=iResolution; float m=min(res.x,res.y); vec2 uv=(fragCoord-0.5*res)/m; float t=iTime; float h=iClock; float back=max(smoothstep(13.0,21.5,h),1.0-smoothstep(2.0,7.0,h)); float rise=smoothstep(5.0,12.0,h)*(1.0-smoothstep(18.0,24.0,h)); float de=dayEnergy(); vec2 c=vec2(0.04*sin(t*0.013)+0.02*sin(t*0.0041+1.3), mix(-0.12,0.05,rise)+0.015*sin(t*0.0071)); c.x+=0.002*sin(6.2831*iBeatPhase); float R=0.235+0.02*rise+0.015*iBreath+0.008*sin(t*0.009); vec2 q=uv-c; float r=length(q); float tint=0.5+0.5*cos(iKey); vec3 A=iColA; vec3 B=mix(iColB,mix(iColB,iColC,0.35),0.25*tint); vec3 C=iColC; vec3 col=A*0.22*(1.0-0.5*length(uv)); col+=A*0.08*(1.0-smoothstep(0.0,0.8,abs(uv.y+0.4))); float az=iSong*6.2831+t*0.02; vec3 L=normalize(vec3(cos(az)*0.55,0.45+0.2*sin(az),mix(0.9,-0.85,back))); float d=max(r-R,0.0); float hw=0.07+0.09*back+0.06*de-0.025*iTension+0.02*iBreath; float halo=exp(-d/hw); vec3 haloCol=mix(B,C,exp(-d/0.06)*(0.4+0.5*back)); col+=haloCol*halo*(0.55+0.25*back); float b1=exp(-pow((r-R*1.5)/(0.16+0.05*de),2.0)); float b2=exp(-pow((r-R*2.1)/(0.26+0.08*de),2.0)); col+=B*(0.07*b1+0.04*b2)*(0.6+0.6*de); float pool=exp(-pow((uv.y-(c.y-R-0.06))/0.05,2.0))*exp(-pow(q.x/(R*1.4),2.0)); col+=B*pool*0.12*(1.0-back*0.5); float rim=exp(-d/(0.012+0.01*(1.0-iBright)))*step(R,r); col+=C*rim*(0.25+0.85*back); float inside=smoothstep(R+0.004,R-0.004,r); if(r<R+0.01){ vec2 p=q/R; float pp=min(dot(p,p),1.0); vec3 n=normalize(vec3(p,sqrt(1.0-pp)+0.001)); float diff=max(dot(n,L),0.0); float wrap=max(dot(n,L)*0.5+0.5,0.0); vec3 glass=mix(A*0.5,B,diff*(1.0-back*0.6)); glass+=B*0.35*(1.0-pp)*(1.0-back*0.55); glass+=mix(B,C,0.5)*0.25*wrap*back*pp; float spec=pow(max(dot(reflect(-L,n),vec3(0.0,0.0,1.0)),0.0),18.0+40.0*iBright); glass+=C*spec*(1.0-back)*1.1; float fres=pow(1.0-n.z,3.0); glass+=mix(B,C,0.8)*fres*(0.35+1.2*back); vec3 Lb=normalize(vec3(-L.x,-L.y,0.5)); glass+=C*0.15*pow(max(dot(n,Lb),0.0),6.0)*(1.0-back); col=mix(col,glass,inside); } col=col/(1.0+0.25*col); col=min(col,vec3(0.94)); fragColor=vec4(col,1.0); }