// Eclipse of a Cold Stone - art of the day 2026-10-18
// A single dark stone sits in deep night while a cold glacier light leaks around its whole rim, a halo that widens to a pale corona at midday and tightens to a hairline of ice as the stone grows into full eclipse by midnight.
float sdPebble(vec2 p, float r, float seed, float t){ float a=atan(p.y,p.x); float rr=r*(1.0+0.035*sin(2.0*a+seed)+0.02*sin(3.0*a+seed*1.7+t)+0.012*sin(5.0*a-seed*0.6)); return length(p*vec2(1.0,1.07))-rr; } float dayE(float h){ float hh=mod(h+24.0,24.0); int i=int(floor(hh)); int j=int(mod(float(i)+1.0,24.0)); float f=smoothstep(0.0,1.0,fract(hh)); float a=iDay[i]*smoothstep(float(i),float(i)+1.0,iClock); float b=iDay[j]*smoothstep(float(j),float(j)+1.0,iClock); return mix(a,b,f); } void mainImage(out vec4 fragColor, in vec2 fragCoord){ vec2 R=iResolution; float m=min(R.x,R.y); vec2 p=(fragCoord-0.5*R)/m; float c=iClock; float t=iTime; float noon=exp(-pow((c-13.0)/4.5,2.0)); float dawn=exp(-pow((c-7.0)/2.0,2.0)); float night=clamp(smoothstep(19.0,23.5,c)+1.0-smoothstep(3.0,6.5,c),0.0,1.0); float late=smoothstep(5.0,23.0,c); vec2 off=vec2(0.025*sin(t*0.011+1.3)+0.012*sin(t*0.0037)+0.022*(late-0.5),0.02*cos(t*0.008)+0.01*sin(t*0.0029+2.0)-0.03*dawn+0.01*night); off.x+=0.002*sin(6.2832*iBeatPhase); vec2 q=p-off; float seed=iSong*6.2832; float r=mix(0.16,0.215,late)+0.006*sin(t*0.005); float d=sdPebble(q,r,seed,t*0.02); float ang=atan(q.x,q.y); float h=mod(ang/6.28318*24.0+24.0,24.0); float rec=(dayE(h-1.0)+2.0*dayE(h)+dayE(h+1.0))*0.25; float w=0.022+0.045*noon+0.012*dawn+0.012*iBreath+0.03*rec; w*=1.0-0.15*iTension; w*=mix(1.0,0.7,night); float od=max(d,0.0); float halo=exp(-od/w); float wide=exp(-od/(0.16+0.04*iBright))*0.22; float rim=exp(-od/0.006)*(0.55+0.2*iTension)*smoothstep(-0.004,0.0,d); float inside=1.0-smoothstep(-0.003,0.002,d); float k=0.5+0.5*cos(iKey); vec3 haloCol=mix(iColB,iColC,clamp(0.35+0.4*noon-0.25*night+0.15*k,0.0,1.0)); vec3 bg=iColA*(0.85+0.35*max(0.0,1.0-length(p))); vec3 col=bg+haloCol*halo*0.85*(1.0-inside)+iColB*wide+iColC*rim*0.8; col+=iColB*0.03*iBright*(1.0-inside); vec2 n=normalize(q+1e-4); float shade=0.5+0.5*dot(n,normalize(vec2(-0.5,0.7))); vec3 peb=iColA*(0.45+0.15*shade)+iColB*0.07*smoothstep(-0.05,0.0,d)*shade; col=mix(col,peb,inside); col=min(col,vec3(0.92)); fragColor=vec4(col,1.0); }