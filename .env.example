# Claude: every AI feature (daily artist, curator and post writer, mirror lines, aura)
ANTHROPIC_API_KEY=your_key_here

# The app's password for remote visitors (the home network needs none)
WALL_PASSWORD=

# Public gallery: a fine-grained GitHub token with "Contents: read and write" on the repo,
# so the wall can publish each day's piece (display/publish.py)
GALLERY_TOKEN=
# WALL_MOODBOARD=fionnferreira/motion-graphics     # the Pinterest board the artist looks at

# Receipt printer: usb (default), http://<other-pi>.local:8631, tcp://<ip>:9100 or serial:/dev/rfcomm0
# WALL_PRINTER=usb
# PRINT_KEY=                                        # shared secret with tools/print_server.py

# Optional Google Drive archive of photos and receipts (token.json from tools/auth_drive.py)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=
