[Unit]
Description=Fortuna wall as a Matter on/off plug (Smart Life, Google Home)
After=network-online.target wall-control.service
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/magic-mirror/matter
Environment=MATTER_LOG_LEVEL=info
ExecStartPre=/bin/sh -c 'test -d node_modules/@matter/main || npm install --no-audit --no-fund'
ExecStart=/usr/bin/node wall.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
