// Embers Along the Walk - art of the day 2026-10-13
// A single lamp crosses the wall in one long arc from dawn to midnight, and every three hours it sets down a soft ember that glows with the music of that hour and slowly cools, so by night the day reads as a few dimming coals behind one warm light.
float hash(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
vec2 path(float h,float asp){float t=clamp((h-5.0)/18.0,0.0,1.0);float x=mix(0.14,0.86,t);float y=0.2+0.6*sin(3.14159*t);x+=0.025*sin(t*7.0+1.3);y+=0.02*sin(t*11.0+0.4);return vec2((x-0.5)*asp,y-0.5);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 R=iResolution;float asp=R.x/R.y;vec2 uv=fragCoord/R;vec2 p=(fragCoord-0.5*R)/R.y;float h=iClock;float day=smoothstep(5.0,12.0,h)*(1.0-smoothstep(20.0,24.0,h));vec2 lp=path(h,asp)+vec2(0.015*sin(iTime*0.013),0.012*cos(iTime*0.0071+1.0))+vec2(0.003*sin(iBeatPhase*6.2832),0.0);vec2 dv=p-lp;float ang=iSong*6.2832;vec2 ax=vec2(cos(ang),sin(ang));float el=1.0+0.08*sin(iTime*0.02);float d=length(vec2(dot(dv,ax)/el,dot(dv,vec2(-ax.y,ax.x))*el));vec3 bg=mix(iColA*0.55,iColA*1.05,uv.y*0.6+0.2);bg*=0.85+0.25*exp(-d*1.2);vec3 col=bg;float r=mix(0.03,0.055,day)*(1.0-0.25*iTension);float rh=mix(0.16,0.28,day)*(1.0+0.15*iBreath);float core=exp(-d*d/(r*r));float halo=exp(-d*d/(rh*rh))*0.6+exp(-d/(rh*0.8))*0.25;float lampI=0.55+0.45*day;vec3 tint=mix(iColB,iColC,clamp(0.3+0.35*day+0.08*sin(iKey),0.0,1.0));col+=halo*tint*0.5*lampI;col+=core*mix(tint,iColC,0.6)*0.85*lampI;for(int k=0;k<6;k++){float hk=6.0+3.0*float(k);float vis=smoothstep(hk+0.3,hk+1.4,h);if(vis<=0.0)continue;float age=h-hk;float e=clamp(iDay[6+3*k],0.0,1.0);float br=(0.3+0.7*e)*exp(-age*0.09)*vis;vec2 ep=path(hk,asp);vec2 q=p-ep;float rr=0.04+0.03*e;float g=exp(-dot(q,q)/(rr*rr));float gw=exp(-dot(q,q)/(rr*rr*6.0));vec3 ec=mix(mix(iColB,iColC,0.25),mix(iColA,iColB,0.6),clamp(age/16.0,0.0,1.0));col+=(g*0.55+gw*0.15)*br*ec;}col+=iColB*0.05*iBright*exp(-d*1.5);col*=1.0-0.25*dot(uv-0.5,uv-0.5);col+=(hash(fragCoord)-0.5)*0.025*(0.6+0.4*iBright);col=col/(1.0+0.35*max(col.r,max(col.g,col.b)));fragColor=vec4(clamp(col,0.0,1.0),1.0);}