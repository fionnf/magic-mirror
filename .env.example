OPENAI_API_KEY=your_key_here
# Optional: enable Google Drive archive of every captured frame.
# Leave blank or omit to disable. Requires gcp-credentials.json in project root.
GOOGLE_DRIVE_FOLDER_ID=
# Optional second folder: archive of rendered receipt PNGs (image + AI line
# composited together). Leave blank to skip.
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=


# Optional: Claude Code as the music "designer brain" (see panel_setup/README.md)
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=haiku
# Free-tier Gemini as the music designer (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
