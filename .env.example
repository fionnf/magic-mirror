# Copy to .env (git-ignored) and fill in what you use. Every line is optional: with nothing set the wall
# still runs, and each feature that needs a key falls back to built-in text or rules.
# The full list of variables, with defaults, is the "Configuration reference" in README.md.

# --- AI: the default provider is OpenAI (config.AI_PROVIDER), so a first setup needs OPENAI_API_KEY ---
# Used for the daily artist, curator and post writer, mirror one-liners, aura readings, booth prompts and the
# wheel. If the chosen provider has no key but ANTHROPIC_API_KEY is set, Claude is used instead.
# OPENAI_API_KEY=
# WALL_AI_PROVIDER=openai          # openai (default) | anthropic | groq
# GROQ_API_KEY=                    # only for WALL_AI_PROVIDER=groq
# Claude: leave your real key here, or DELETE this line if you do not use Claude. The placeholder below is a
# non-empty value, so with no OPENAI_API_KEY the wall would try Claude with it and fall back to canned text.
ANTHROPIC_API_KEY=your_key_here

# The app's password for visitors from outside your home network (the home network needs none).
# Empty = remote access is off. See docs/remote-access.md
WALL_PASSWORD=

# Public gallery (see docs/gallery.md): a fine-grained GitHub token with "Contents: read and write" on the
# repo, so the wall can publish each day's piece (display/publish.py). Leave empty to publish nothing.
GALLERY_TOKEN=
# GALLERY_REPO=you/magic-mirror    # default fionnf/magic-mirror: set this when you use your own fork
# GALLERY_RAW=https://raw.githubusercontent.com/you/magic-mirror/master/gallery/   # where the wall fetches daily pieces
# WALL_MOODBOARD=fionnferreira/motion-graphics     # a public Pinterest board "user/board" the artist looks at

# Receipt printer: usb (default), http://<other-pi>.local:8631, tcp://<ip>:9100 or serial:/dev/rfcomm0
# WALL_PRINTER=usb
# PRINT_KEY=                                        # shared secret with tools/print_server.py

# Optional Google Drive archive of photos and receipts (token.json from tools/auth_drive.py,
# see docs/google-drive.md). The receipts folder defaults to the main folder.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=

# Zürich tram map: reserved for live delays (free key from api-manager.opentransportdata.swiss, GTFS-RT).
# Nothing in the code reads it yet: the Tram map piece is timetable-only.
OTD_API_KEY=
